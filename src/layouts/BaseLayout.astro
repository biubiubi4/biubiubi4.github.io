---
import { nav, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#d9f24a" />
    <link rel="icon" href="/images/head/head.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label={site.title}>
          <img src={site.avatar} alt="" width="48" height="48" />
          <span>
            <strong>{site.title}</strong>
            <small>{site.subtitle}</small>
          </span>
        </a>
        <nav aria-label="主导航">
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </header>

      <main>
        <slot />
      </main>
    </div>

    <footer class="site-footer">
      <p>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        <span>/</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>/</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{site.icp}</a>
      </p>
      <p>本文采用 {site.license} 协议进行许可。</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #f8edc9;
    --surface: #fffaf0;
    --surface-soft: rgba(255, 250, 240, 0.86);
    --surface-muted: #f0e4c7;
    --text: #172015;
    --muted: #6d674c;
    --line: rgba(42, 40, 25, 0.15);
    --primary: #d9f24a;
    --primary-soft: #f3ffbd;
    --primary-strong: #6f9418;
    --earth: #c95430;
    --sun: #f6ae4b;
    --road: #25251e;
    --blue: #35778a;
    --shadow: 0 22px 68px rgba(62, 46, 24, 0.17);
    --radius: 8px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      linear-gradient(115deg, rgba(255, 250, 240, 0.92) 0 34%, transparent 34% 100%),
      radial-gradient(circle at 78% 12%, rgba(217, 242, 74, 0.46), transparent 19rem),
      radial-gradient(circle at 16% 8%, rgba(246, 174, 75, 0.28), transparent 18rem),
      linear-gradient(180deg, #fff5cf 0%, #f3d08d 42%, #d9793b 70%, #27251d 100%);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Microsoft YaHei", "PingFang SC", sans-serif;
    letter-spacing: 0;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(23, 32, 21, 0.08) 1px, transparent 1px),
      linear-gradient(180deg, rgba(23, 32, 21, 0.06) 1px, transparent 1px);
    background-size: 48px 48px;
    content: "";
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.58), transparent 76%);
  }

  body::after {
    position: fixed;
    inset: auto 0 0;
    z-index: -1;
    height: 42vh;
    background:
      linear-gradient(90deg, transparent 0 47%, rgba(217, 242, 74, 0.32) 47% 49%, transparent 49% 51%, rgba(217, 242, 74, 0.32) 51% 53%, transparent 53%),
      linear-gradient(180deg, transparent, rgba(23, 32, 21, 0.9));
    content: "";
    pointer-events: none;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--earth);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .site-shell {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem;
    margin: 0 auto;
    padding: 14px 0;
    backdrop-filter: blur(18px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 230px;
  }

  .brand img {
    border: 2px solid rgba(23, 32, 21, 0.88);
    border-radius: 8px;
    background: var(--road);
    box-shadow: 0 12px 26px rgba(23, 32, 21, 0.24);
  }

  .brand span {
    display: grid;
    gap: 0.1rem;
  }

  .brand strong {
    color: var(--text);
    font-size: 1rem;
  }

  .brand small {
    color: var(--muted);
    font-size: 0.8rem;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  nav a {
    border: 1px solid rgba(23, 32, 21, 0.08);
    border-radius: 999px;
    background: rgba(255, 250, 240, 0.5);
    padding: 0.5rem 0.78rem;
    color: rgba(23, 32, 21, 0.72);
    font-size: 0.92rem;
  }

  nav a:hover {
    border-color: rgba(23, 32, 21, 0.18);
    background: rgba(217, 242, 74, 0.62);
    color: var(--text);
  }

  main {
    margin: 0 auto;
  }

  .site-footer {
    width: min(1180px, calc(100% - 32px));
    margin: 4rem auto 0;
    padding: 2rem 0 3rem;
    border-top: 1px solid rgba(255, 250, 240, 0.2);
    color: rgba(255, 250, 240, 0.75);
    font-size: 0.92rem;
  }

  .site-footer p {
    margin: 0.35rem 0;
  }

  .site-footer span {
    margin: 0 0.45rem;
    color: rgba(217, 242, 74, 0.58);
  }

  .page-title {
    position: relative;
    margin: 3rem 0 2rem;
    border: 1px solid rgba(255, 250, 240, 0.54);
    border-radius: var(--radius);
    background:
      linear-gradient(110deg, rgba(255, 250, 240, 0.95) 0%, rgba(255, 250, 240, 0.82) 48%, rgba(217, 242, 74, 0.18) 100%),
      url("/images/background/xiaomai.jpg") center / cover;
    padding: clamp(1.4rem, 4vw, 2.4rem);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .page-title::before {
    position: absolute;
    inset: auto 1.5rem 1.2rem auto;
    width: 120px;
    height: 12px;
    border-radius: 999px;
    background: var(--primary);
    content: "";
  }

  .page-title > * {
    position: relative;
    z-index: 1;
  }

  .page-title h1 {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 4.5rem);
    line-height: 1;
    text-wrap: balance;
  }

  .page-title p {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .prose {
    max-width: 820px;
    border: 1px solid rgba(255, 250, 240, 0.5);
    border-radius: var(--radius);
    background: var(--surface-soft);
    padding: clamp(1.15rem, 3vw, 1.7rem);
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.9;
    box-shadow: var(--shadow);
  }

  .prose h2,
  .prose h3 {
    margin-top: 2.2rem;
    line-height: 1.25;
  }

  .prose a {
    color: var(--earth);
    border-bottom: 1px solid rgba(201, 84, 48, 0.35);
  }

  .prose code {
    border-radius: 6px;
    background: var(--surface-muted);
    padding: 0.15rem 0.35rem;
  }

  .prose pre {
    overflow-x: auto;
    border-radius: var(--radius);
    background: var(--road);
    padding: 1rem 1.1rem;
    color: #fffaf0;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    padding: 0;
    list-style: none;
  }

  .pill-list li,
  .pill {
    border: 1px solid rgba(23, 32, 21, 0.13);
    border-radius: 999px;
    background: rgba(255, 250, 240, 0.8);
    padding: 0.48rem 0.76rem;
    color: #3f3a25;
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
      align-items: flex-start;
      flex-direction: column;
    }

    .brand {
      min-width: 0;
    }

    nav {
      justify-content: flex-start;
    }

    nav a {
      padding: 0.45rem 0.65rem;
    }
  }
</style>
