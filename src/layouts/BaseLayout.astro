---
import { nav, site } from "../data/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
const pageTitle = title === site.title ? site.title : `${title} | ${site.title}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e67249" />
    <link rel="icon" href="/images/head/head.svg" type="image/svg+xml" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label={site.title}>
        <img src={site.avatar} alt="" width="44" height="44" />
        <span>
          <strong>{site.title}</strong>
          <small>{site.subtitle}</small>
        </span>
      </a>
      <nav aria-label="主导航">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
        <span>/</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <span>/</span>
        <a href="https://beian.miit.gov.cn/" target="_blank" rel="noreferrer">{site.icp}</a>
      </p>
      <p>本文采用 {site.license} 协议进行许可。</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #faf7f2;
    --surface: #fffdf9;
    --surface-muted: #f2eee7;
    --text: #22201d;
    --muted: #6d6962;
    --line: #e2d9cf;
    --primary: #d85f3c;
    --primary-strong: #a83d26;
    --green: #2f7665;
    --blue: #496f9e;
    --shadow: 0 18px 50px rgba(44, 34, 25, 0.08);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    min-height: 100vh;
    background:
      radial-gradient(circle at 14% 10%, rgba(216, 95, 60, 0.12), transparent 28rem),
      linear-gradient(135deg, #faf7f2 0%, #f7fbf9 48%, #f9f4eb 100%);
    color: var(--text);
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      "Microsoft YaHei", sans-serif;
    letter-spacing: 0;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--primary-strong);
  }

  img {
    max-width: 100%;
    height: auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
    padding: 16px 0;
    backdrop-filter: blur(16px);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 210px;
  }

  .brand img {
    border-radius: 50%;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .brand span {
    display: grid;
    gap: 0.1rem;
  }

  .brand strong {
    font-size: 1rem;
  }

  .brand small {
    color: var(--muted);
    font-size: 0.8rem;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  nav a {
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  nav a:hover {
    background: rgba(216, 95, 60, 0.1);
    color: var(--primary-strong);
  }

  main {
    width: min(1120px, calc(100% - 32px));
    margin: 0 auto;
  }

  .site-footer {
    width: min(1120px, calc(100% - 32px));
    margin: 4rem auto 0;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
  }

  .site-footer p {
    margin: 0.35rem 0;
  }

  .site-footer span {
    margin: 0 0.45rem;
    color: #b6aaa0;
  }

  .page-title {
    margin: 3.5rem 0 2rem;
  }

  .page-title h1 {
    margin: 0;
    font-size: clamp(2.1rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .page-title p {
    max-width: 720px;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.85;
  }

  .prose {
    max-width: 820px;
    color: var(--text);
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .prose h2,
  .prose h3 {
    margin-top: 2.2rem;
    line-height: 1.25;
  }

  .prose a {
    color: var(--primary-strong);
    border-bottom: 1px solid rgba(216, 95, 60, 0.35);
  }

  .prose code {
    border-radius: 6px;
    background: var(--surface-muted);
    padding: 0.15rem 0.35rem;
  }

  .prose pre {
    overflow-x: auto;
    border-radius: 8px;
    background: #211f1c;
    padding: 1rem 1.1rem;
    color: #fff7ed;
  }

  .pill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    list-style: none;
  }

  .pill-list li,
  .pill {
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 253, 249, 0.72);
    padding: 0.45rem 0.75rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    nav a {
      padding: 0.45rem 0.65rem;
    }
  }
</style>
